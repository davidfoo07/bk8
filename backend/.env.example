# Database — local Docker Postgres:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/courtedge
# ...or Supabase: use the *Session pooler* string (Connect → Connection String →
# Method: Session pooler), not Direct (IPv6-only on the free tier) or the
# Transaction pooler (breaks asyncpg). Change the scheme to postgresql+asyncpg://
# and append ?ssl=require:
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?ssl=require
# Migrations derive their URL from DATABASE_URL: run `./venv/bin/alembic upgrade head`.
# Tests never touch this database (see tests/conftest.py).

# Redis (optional for MVP)
REDIS_URL=redis://localhost:6379/0

# Environment
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# API Keys (future)
# ODDS_API_KEY=
